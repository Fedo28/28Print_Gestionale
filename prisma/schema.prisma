generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
}

enum CustomerType {
  PUBBLICO
  AZIENDA
}

enum CustomerAccountStatus {
  ACTIVE
  DISABLED
}

enum CustomerAddressType {
  SHIPPING
  BILLING
  BOTH
}

enum BillingProfileKind {
  PRIVATE
  BUSINESS
  PROFESSIONAL
}

enum MainPhase {
  ACCETTATO
  CALENDARIZZATO
  IN_LAVORAZIONE
  SVILUPPO_COMPLETATO
  CONSEGNATO
}

enum OperationalStatus {
  ATTIVO
  IN_ATTESA_FILE
  IN_ATTESA_MATERIALE
  IN_ATTESA_APPROVAZIONE
}

enum PaymentStatus {
  NON_PAGATO
  ACCONTO
  PARZIALE
  PAGATO
}

enum InvoiceStatus {
  DA_FATTURARE
  FATTURATO
  NON_RICHIESTO
}

enum Priority {
  BASSA
  MEDIA
  ALTA
  URGENTE
}

enum DiscountMode {
  NONE
  AMOUNT
  PERCENT
}

enum PaymentMethod {
  CONTANTI
  CARTA
  BONIFICO
  ALTRO
}

enum PaymentEntryStatus {
  ATTIVO
  SOSTITUITO
}

enum SalesOrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  PAYMENT_FAILED
  CANCELLED
  FULFILLED
}

enum SalesOrderOrigin {
  SHOP_ONLINE
}

enum PaymentProvider {
  STRIPE
}

enum PaymentRecordStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum FileAssetVisibility {
  PRIVATE
  STAFF_ONLY
}

enum DomainEventStatus {
  PENDING
  PROCESSED
  FAILED
}

enum SalesOrderJobLinkReason {
  AUTO_PRODUCT_POLICY
  INVOICE_REQUESTED
  AUTO_PRODUCT_POLICY_AND_INVOICE_REQUESTED
  MANUAL
}

enum ServiceUnit {
  PZ
  MQ
  ML
}

enum BillboardAssetKind {
  CARTELLONE
  MONITOR
  VELA_ITINERANTE
}

enum BillboardBookingStatus {
  OPZIONATO
  CONFERMATO
  SCADUTO
}

enum PurchaseNoteUrgency {
  NORMALE
  URGENTE
  BLOCCANTE
}

enum HistoryType {
  CREATED
  UPDATED
  PHASE_CHANGED
  STATUS_CHANGED
  PAYMENT_RECORDED
  ATTACHMENT_UPLOADED
  NOTE
}

enum AuditEntityType {
  ORDER
  CUSTOMER
  PURCHASE_NOTE
  BILLBOARD_BOOKING
  SERVICE_CATALOG
  APP_SETTING
  STAFF_USER
}

enum AuditActionType {
  CREATED
  UPDATED
  DELETED
  COMPLETED
  REOPENED
}

model User {
  id           String   @id @default(uuid())
  name         String
  nickname     String   @unique
  email        String   @unique
  passwordHash String
  role         UserRole @default(OPERATOR)
  active       Boolean  @default(true)
  invitePreparedAt DateTime?
  inviteSentAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  auditLogs    AuditLog[]
  pushSubscriptions StaffPushSubscription[]
}

model Customer {
  id         String   @id @default(uuid())
  name       String
  type       CustomerType @default(PUBBLICO)
  phone      String?
  whatsapp   String?
  email      String?
  pec        String?
  taxCode    String?
  vatNumber  String?
  uniqueCode String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  orders     Order[]
  accounts   CustomerAccount[]
  addresses  CustomerAddress[]
  billingProfiles CustomerBillingProfile[]
  salesOrders SalesOrder[]
  fileAssets FileAsset[]
  billboardBookings BillboardBooking[]
  purchaseNotes PurchaseNote[]

  @@index([name])
  @@index([phone])
  @@index([pec])
  @@index([type])
  @@index([uniqueCode])
}

model CustomerAccount {
  id                 String                @id @default(uuid())
  customerId         String
  email              String
  emailNormalized    String                @unique
  passwordHash       String
  status             CustomerAccountStatus @default(ACTIVE)
  emailVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  invitedAt          DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  customer           Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  salesOrders        SalesOrder[]
  uploadedFileAssets FileAsset[]

  @@unique([customerId, emailNormalized])
  @@index([customerId, status])
}

model CustomerAddress {
  id         String              @id @default(uuid())
  customerId String
  type       CustomerAddressType @default(BOTH)
  label      String?
  fullName   String?
  companyName String?
  line1      String
  line2      String?
  postalCode String?
  city       String
  province   String?
  country    String              @default("IT")
  phone      String?
  isDefault  Boolean             @default(false)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  customer   Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, type, isDefault])
}

model CustomerBillingProfile {
  id           String             @id @default(uuid())
  customerId   String
  kind         BillingProfileKind @default(PRIVATE)
  label        String?
  firstName    String?
  lastName     String?
  fullName     String?
  companyName  String?
  taxCode      String?
  vatNumber    String?
  sdiCode      String?
  pec          String?
  addressLine1 String?
  addressLine2 String?
  postalCode   String?
  city         String?
  province     String?
  country      String             @default("IT")
  phone        String?
  isDefault    Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  customer     Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, kind, isDefault])
}

model Order {
  id                  String            @id @default(uuid())
  customerId          String
  orderCode           String            @unique
  title               String
  titleNormalized     String
  createdOn           String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deliveryAt          DateTime
  deliveredAt         DateTime?
  appointmentAt       DateTime?
  appointmentNote     String?
  schedulePending     Boolean           @default(false)
  priority            Priority          @default(MEDIA)
  isQuote             Boolean           @default(false)
  mainPhase           MainPhase         @default(ACCETTATO)
  operationalStatus   OperationalStatus @default(ATTIVO)
  operationalNote     String?
  paymentStatus       PaymentStatus     @default(NON_PAGATO)
  invoiceStatus       InvoiceStatus     @default(DA_FATTURARE)
  totalCents          Int               @default(0)
  depositCents        Int               @default(0)
  paidCents           Int               @default(0)
  balanceDueCents     Int               @default(0)
  readyWhatsappSentAt DateTime?
  notes               String?
  customer            Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items               OrderItem[]
  attachments         Attachment[]
  payments            Payment[]
  history             OrderHistory[]
  purchaseNotes       PurchaseNote[]
  salesOrderLinks     SalesOrderJobLink[]

  @@unique([createdOn, titleNormalized])
  @@index([deliveryAt])
  @@index([deliveredAt])
  @@index([appointmentAt])
  @@index([isQuote])
  @@index([mainPhase, operationalStatus])
  @@index([paymentStatus])
  @@index([readyWhatsappSentAt])
}

model OrderItem {
  id               String          @id @default(uuid())
  orderId          String
  serviceCatalogId String?
  label            String
  description      String?
  quantity         Float           @default(1)
  catalogBasePriceCents Int?
  discountMode     DiscountMode    @default(NONE)
  discountValue    Int             @default(0)
  extraMode        DiscountMode    @default(NONE)
  extraValue       Int             @default(0)
  unitPriceCents   Int             @default(0)
  lineTotalCents   Int             @default(0)
  format           String?
  material         String?
  finishing        String?
  notes            String?
  deliveredAt      DateTime?
  createdAt        DateTime        @default(now())
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceCatalog   ServiceCatalog? @relation(fields: [serviceCatalogId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([orderId, deliveredAt])
}

model ServiceCatalog {
  id             String      @id @default(uuid())
  code           String?     @unique
  name           String
  description    String?
  basePriceCents Int         @default(0)
  unit           ServiceUnit @default(PZ)
  quantityTiers  String?
  active         Boolean     @default(true)
  onlineActive   Boolean     @default(false)
  onlineSlug     String?     @unique
  createJobAutomatically Boolean @default(false)
  shopSortOrder  Int         @default(0)
  shopConfigurationSchema Json?
  shopPricingSchema Json?
  shopFilePolicy Json?
  shopProductionPolicy Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]
  salesOrderItems SalesOrderItem[]
}

model SalesOrder {
  id                String           @id @default(uuid())
  customerId        String
  customerAccountId String?
  orderCode         String           @unique
  status            SalesOrderStatus @default(DRAFT)
  origin            SalesOrderOrigin @default(SHOP_ONLINE)
  currency          String           @default("EUR")
  invoiceRequested  Boolean          @default(false)
  subtotalCents     Int              @default(0)
  discountCents     Int              @default(0)
  extraCents        Int              @default(0)
  totalCents        Int              @default(0)
  notes             String?
  placedAt          DateTime?
  paidAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  customer          Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerAccount   CustomerAccount? @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)
  items             SalesOrderItem[]
  billingSnapshot   SalesOrderBillingSnapshot?
  payments          PaymentRecord[]
  jobLinks          SalesOrderJobLink[]

  @@index([customerId, createdAt])
  @@index([customerAccountId, createdAt])
  @@index([status, createdAt])
  @@index([origin, createdAt])
}

model SalesOrderItem {
  id                           String          @id @default(uuid())
  salesOrderId                 String
  serviceCatalogId             String?
  label                        String
  description                  String?
  quantity                     Float           @default(1)
  configuration                Json?
  pricingSnapshot              Json?
  unitPriceCents               Int             @default(0)
  lineTotalCents               Int             @default(0)
  createJobAutomaticallyResolved Boolean       @default(false)
  createdAt                    DateTime        @default(now())
  updatedAt                    DateTime        @updatedAt
  salesOrder                   SalesOrder      @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  serviceCatalog               ServiceCatalog? @relation(fields: [serviceCatalogId], references: [id], onDelete: SetNull)
  files                        SalesOrderItemFile[]
  jobLinks                     SalesOrderJobLink[]

  @@index([salesOrderId, createdAt])
  @@index([serviceCatalogId])
}

model SalesOrderBillingSnapshot {
  id           String             @id @default(uuid())
  salesOrderId String             @unique
  kind         BillingProfileKind @default(PRIVATE)
  firstName    String?
  lastName     String?
  fullName     String?
  companyName  String?
  taxCode      String?
  vatNumber    String?
  sdiCode      String?
  pec          String?
  addressLine1 String?
  addressLine2 String?
  postalCode   String?
  city         String?
  province     String?
  country      String             @default("IT")
  phone        String?
  rawJson      Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  salesOrder   SalesOrder         @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
}

model FileAsset {
  id                        String           @id @default(uuid())
  ownerCustomerId           String
  uploadedByCustomerAccountId String?
  originalName              String
  mimeType                  String
  fileSize                  Int
  storageProvider           String
  storageKey                String           @unique
  storagePath               String?
  visibility                FileAssetVisibility @default(PRIVATE)
  expiresAt                 DateTime?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  ownerCustomer             Customer         @relation(fields: [ownerCustomerId], references: [id], onDelete: Restrict)
  uploadedByCustomerAccount CustomerAccount? @relation(fields: [uploadedByCustomerAccountId], references: [id], onDelete: SetNull)
  salesOrderItems           SalesOrderItemFile[]

  @@index([ownerCustomerId, createdAt])
  @@index([uploadedByCustomerAccountId, createdAt])
  @@index([expiresAt])
}

model SalesOrderItemFile {
  id            String         @id @default(uuid())
  salesOrderItemId String
  fileAssetId   String
  createdAt     DateTime       @default(now())
  salesOrderItem SalesOrderItem @relation(fields: [salesOrderItemId], references: [id], onDelete: Cascade)
  fileAsset     FileAsset      @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)

  @@unique([salesOrderItemId, fileAssetId])
  @@index([fileAssetId])
}

model Attachment {
  id        String   @id @default(uuid())
  orderId   String
  fileName  String
  filePath  String
  mimeType  String?
  sizeBytes Int      @default(0)
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Payment {
  id                 String             @id @default(uuid())
  orderId            String
  amountCents        Int
  method             PaymentMethod
  note               String?
  status             PaymentEntryStatus @default(ATTIVO)
  effectiveAt        DateTime           @default(now())
  correctedPaymentId String?            @unique
  createdAt          DateTime           @default(now())
  order              Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  correctedPayment   Payment?           @relation("PaymentCorrection", fields: [correctedPaymentId], references: [id], onDelete: SetNull)
  correction         Payment?           @relation("PaymentCorrection")

  @@index([orderId])
  @@index([orderId, status, effectiveAt])
}

model PaymentRecord {
  id                        String              @id @default(uuid())
  salesOrderId              String
  provider                  PaymentProvider     @default(STRIPE)
  providerCheckoutSessionId String?             @unique
  providerPaymentIntentId   String?             @unique
  amountCents               Int
  currency                  String              @default("EUR")
  status                    PaymentRecordStatus @default(CREATED)
  paidAt                    DateTime?
  failureCode               String?
  failureMessage            String?
  rawProviderSnapshot       Json?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  salesOrder                SalesOrder          @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([salesOrderId, status, createdAt])
}

model PaymentWebhookEvent {
  id               String            @id @default(uuid())
  provider         PaymentProvider   @default(STRIPE)
  providerEventId  String            @unique
  eventType        String
  objectId         String?
  payloadJson      Json?
  processingStatus DomainEventStatus @default(PENDING)
  processedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([provider, eventType, createdAt])
  @@index([processingStatus, createdAt])
}

model SalesOrderJobLink {
  id             String                  @id @default(uuid())
  salesOrderId   String
  salesOrderItemId String?
  orderId        String
  reason         SalesOrderJobLinkReason
  createdAt      DateTime                @default(now())
  salesOrder     SalesOrder              @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  salesOrderItem SalesOrderItem?         @relation(fields: [salesOrderItemId], references: [id], onDelete: SetNull)
  order          Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([salesOrderId, orderId])
  @@index([salesOrderItemId])
  @@index([orderId])
}

model OrderHistory {
  id          String      @id @default(uuid())
  orderId     String
  type        HistoryType
  description String
  details     String?
  snapshotBefore Json?
  snapshotAfter  Json?
  createdAt   DateTime    @default(now())
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model AuditLog {
  id             String          @id @default(uuid())
  entityType     AuditEntityType
  entityId       String
  entityLabel    String
  actionType     AuditActionType
  title          String
  details        String?
  snapshotBefore Json?
  snapshotAfter  Json?
  actorUserId    String?
  createdAt      DateTime        @default(now())
  actorUser      User?           @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
}

model AppSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DomainEvent {
  id          String            @id @default(uuid())
  topic       String
  entityType  String
  entityId    String
  dedupeKey   String            @unique
  payloadJson Json?
  status      DomainEventStatus @default(PENDING)
  processedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([topic, createdAt])
  @@index([status, createdAt])
  @@index([entityType, entityId, createdAt])
}

model StaffPushSubscription {
  id            String   @id @default(uuid())
  userId        String
  endpoint      String   @unique
  p256dh        String
  auth          String
  userAgent     String?
  active        Boolean  @default(true)
  lastSeenAt    DateTime @default(now())
  lastSentAt    DateTime?
  failedAt      DateTime?
  failureReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
  @@index([active, updatedAt])
}

model PurchaseNote {
  id           String    @id @default(uuid())
  customerId   String?
  orderId      String?
  customerName String
  content      String
  urgency      PurchaseNoteUrgency @default(NORMALE)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order        Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([completedAt, createdAt])
  @@index([customerId])
  @@index([orderId])
}

model BillboardAsset {
  id        String             @id @default(uuid())
  code      String             @unique
  name      String
  kind      BillboardAssetKind @default(CARTELLONE)
  location  String?
  sortOrder Int                @default(0)
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  bookings  BillboardBooking[]

  @@index([kind, active])
  @@index([sortOrder])
}

model BillboardBooking {
  id               String         @id @default(uuid())
  billboardAssetId String
  customerId       String
  status           BillboardBookingStatus @default(CONFERMATO)
  monitorSlot      Int?
  startsAt         DateTime
  endsAt           DateTime
  priceCents       Int            @default(0)
  paidCents        Int            @default(0)
  balanceDueCents  Int            @default(0)
  note             String?
  pdfFileName      String?
  pdfFilePath      String?
  pdfMimeType      String?
  pdfSizeBytes     Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  billboardAsset   BillboardAsset @relation(fields: [billboardAssetId], references: [id], onDelete: Restrict)
  customer         Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([billboardAssetId, startsAt, endsAt])
  @@index([billboardAssetId, monitorSlot, startsAt, endsAt])
  @@index([customerId, startsAt])
  @@index([startsAt])
  @@index([endsAt])
  @@index([status, startsAt])
}
