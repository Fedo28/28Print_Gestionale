diff --git a/lib/visible-polling.ts b/lib/visible-polling.ts
new file mode 100644
index 00000000..634ca556
--- /dev/null
+++ b/lib/visible-polling.ts
@@ -0,0 +1,32 @@
+type PollOptions = { intervalMs: number; immediate?: boolean };
+
+// Browser-only lifecycle. Hidden/offline tabs do no work and slow requests never overlap.
+export function startVisiblePolling(task: (signal: AbortSignal) => void | Promise<void>, options: PollOptions) {
+  let stopped = false;
+  let pending = false;
+  let lastStarted = options.immediate === false ? Date.now() : -Infinity;
+  const controller = new AbortController();
+  const poll = async () => {
+    if (stopped || pending || document.visibilityState !== "visible" || !navigator.onLine ||
+      Date.now() - lastStarted < options.intervalMs) return;
+    pending = true;
+    lastStarted = Date.now();
+    try { await task(controller.signal); }
+    catch { /* A transient failure must not create an unhandled rejection or a retry loop. */ }
+    finally { pending = false; }
+  };
+  const wake = () => { void poll(); };
+  const timer = window.setInterval(wake, options.intervalMs);
+  document.addEventListener("visibilitychange", wake);
+  window.addEventListener("focus", wake);
+  window.addEventListener("online", wake);
+  if (options.immediate !== false) wake();
+  return () => {
+    stopped = true;
+    controller.abort();
+    window.clearInterval(timer);
+    document.removeEventListener("visibilitychange", wake);
+    window.removeEventListener("focus", wake);
+    window.removeEventListener("online", wake);
+  };
+}
diff --git a/tests/visible-polling.test.ts b/tests/visible-polling.test.ts
new file mode 100644
index 00000000..61360167
--- /dev/null
+++ b/tests/visible-polling.test.ts
@@ -0,0 +1,66 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { startVisiblePolling } from "../lib/visible-polling";
+
+let page: EventTarget & { visibilityState: string };
+let browser: EventTarget;
+let connection: { onLine: boolean };
+let stop: (() => void) | undefined;
+beforeEach(() => {
+  vi.useFakeTimers();
+  page = Object.assign(new EventTarget(), { visibilityState: "visible" });
+  browser = Object.assign(new EventTarget(), { setInterval, clearInterval });
+  connection = { onLine: true };
+  vi.stubGlobal("document", page);
+  vi.stubGlobal("window", browser);
+  vi.stubGlobal("navigator", connection);
+});
+afterEach(() => { stop?.(); stop = undefined; vi.unstubAllGlobals(); vi.useRealTimers(); });
+
+describe("visible polling", () => {
+  it("does no background work and refreshes when a stale hidden tab becomes visible", async () => {
+    const task = vi.fn();
+    page.visibilityState = "hidden";
+    stop = startVisiblePolling(task, { intervalMs: 30_000 });
+    await vi.advanceTimersByTimeAsync(120_000);
+    expect(task).not.toHaveBeenCalled();
+    page.visibilityState = "visible";
+    page.dispatchEvent(new Event("visibilitychange"));
+    await Promise.resolve();
+    expect(task).toHaveBeenCalledTimes(1);
+    browser.dispatchEvent(new Event("focus"));
+    await vi.advanceTimersByTimeAsync(1000);
+    expect(task).toHaveBeenCalledTimes(1);
+  });
+  it("does not overlap slow requests and aborts them on disposal", async () => {
+    const task = vi.fn((_signal: AbortSignal) => new Promise<void>(() => {}));
+    stop = startVisiblePolling(task, { intervalMs: 30_000 });
+    await vi.advanceTimersByTimeAsync(120_000);
+    expect(task).toHaveBeenCalledTimes(1);
+    const signal = task.mock.calls[0][0];
+    stop();
+    expect(signal.aborted).toBe(true);
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(task).toHaveBeenCalledTimes(1);
+  });
+  it("waits for the first interval for server-rendered content, pauses offline and resumes online", async () => {
+    const task = vi.fn();
+    stop = startVisiblePolling(task, { intervalMs: 60_000, immediate: false });
+    browser.dispatchEvent(new Event("focus"));
+    expect(task).not.toHaveBeenCalled();
+    connection.onLine = false;
+    await vi.advanceTimersByTimeAsync(120_000);
+    expect(task).not.toHaveBeenCalled();
+    connection.onLine = true;
+    browser.dispatchEvent(new Event("online"));
+    await Promise.resolve();
+    expect(task).toHaveBeenCalledTimes(1);
+  });
+  it("retries a failure at the normal interval without a tight loop", async () => {
+    const task = vi.fn().mockRejectedValueOnce(new Error("offline")).mockResolvedValue(undefined);
+    stop = startVisiblePolling(task, { intervalMs: 30_000 });
+    await vi.advanceTimersByTimeAsync(29_999);
+    expect(task).toHaveBeenCalledTimes(1);
+    await vi.advanceTimersByTimeAsync(1);
+    expect(task).toHaveBeenCalledTimes(2);
+  });
+});
